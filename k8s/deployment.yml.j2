apiVersion: apps/v1
kind: Deployment
metadata:
  name: java-cicd-app
spec:
  replicas: 5
  selector:
    matchLabels:
      app: java-cicd-app
  template:
    metadata:
      labels:
        app: java-cicd-app
    spec:
      containers:
        - name: java-cicd-app
          image: {{ image }}
          ports:
            - containerPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: java-cicd-app-svc
spec:
  type: NodePort
  selector:
    app: java-cicd-app
  ports:
    - port: 8080
      targetPort: 8080
      nodePort: 30080
